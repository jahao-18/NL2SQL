# 千问 API Key,在 https://dashscope.console.aliyun.com 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_SECRET=请改成一段仅本机使用的随机字符串
# 仅在课堂演示环境开启；开启后登录页会展示演示账号。
DEMO_MODE=false
# LLM 模型,默认 qwen-plus,可改 qwen-max / qwen-turbo
QWEN_MODEL=qwen-plus

# 数据源配置在 data_sources.yaml 里维护,不在 .env 里
# 可选:用 DATA_SOURCES_FILE 指向其它路径
# DATA_SOURCES_FILE=/path/to/your/data_sources.yaml

# SQL 执行限制
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=45
LLM_ENABLE_THINKING=false
MAX_UPLOAD_BYTES=20971520
PREWARM_ENABLED=false

# 自适应 Schema 检索：先按角色授权过滤；小视图直接使用完整授权 Schema，
# 只有授权后表数或列数超过阈值时才并行使用本地向量 + BM25，并用关系图补全 JOIN。
RETRIEVAL_ENABLED=true
RETRIEVAL_BACKEND=local
RETRIEVAL_QUERY_EXPANSION=false
RETRIEVAL_MIN_TABLES=15
RETRIEVAL_MIN_COLUMNS=120
RETRIEVAL_TOP_TABLES=8
RETRIEVAL_TOP_K=20
